<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>2f5dceb4-3db2-43bc-bb80-d29917044d75</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>EVAText</ProviderName>
  <DefaultLocale>es-CO</DefaultLocale>
  <DisplayName DefaultValue="EVAText Web"/>
  <Description DefaultValue="Asistente para insertar comentarios de retroalimentación en textos académicos."/>
  <IconUrl DefaultValue="https://lauramqu.github.io/EVAText-Web/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://lauramqu.github.io/EVAText-Web/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://lauramqu.github.io/EVAText-Web/support.html"/>  
  <AppDomains>
  <AppDomain>https://github.com</AppDomain>
  <AppDomain>https://lauramqu.github.io</AppDomain>
   </AppDomains>
  <Hosts>
    <Host Name="Document"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://lauramqu.github.io/EVAText-Web/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="TabEVAText">
              <Group id="CommandsGroup">
                <Label resid="CommandsGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
              <Label resid="CustomTab.Label"/>
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://lauramqu.github.io/EVAText-Web/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://lauramqu.github.io/EVAText-Web/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://lauramqu.github.io/EVAText-Web/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://go.microsoft.com/fwlink/?LinkId=276812"/>
        <bt:Url id="Commands.Url" DefaultValue="https://lauramqu.github.io/EVAText-Web/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://lauramqu.github.io/EVAText-Web/taskpane.html"/>
      </bt:Urls>
<bt:ShortStrings>
  <bt:String
    id="GetStarted.Title"
    DefaultValue="EVAText está listo"/>

  <bt:String
    id="CommandsGroup.Label"
    DefaultValue="Comentarios"/>

  <bt:String
    id="CustomTab.Label"
    DefaultValue="EVAText"/>

  <bt:String
    id="TaskpaneButton.Label"
    DefaultValue="Abrir EVAText"/>
</bt:ShortStrings>
<bt:LongStrings>
  <bt:String
    id="GetStarted.Description"
    DefaultValue="Ve a la pestaña EVAText y presiona Abrir EVAText para comenzar."/>

  <bt:String
    id="TaskpaneButton.Tooltip"
    DefaultValue="Abre el catálogo de comentarios de EVAText"/>
</bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
